# Shared secret with the portrait bot's LIBRARY_API_INTERNAL_TOKEN (same
# value in both .env files). Gates the one write endpoint,
# POST /internal/ingest -- generate with e.g. `openssl rand -hex 24`.
# Leave blank to disable ingest entirely (the API still serves whatever
# was already ingested, read-only, matching Auldwyn-Lore's
# INTERNAL_API_TOKEN "blank disables the bypass" convention, just applied
# to an actual write path here instead of a rate-limit bypass).
INTERNAL_API_TOKEN=

# Host port library_api is published on. Chosen to avoid the other
# Auldwyn stacks already running on this box (8000 chroma, 8001
# query_api, 8080 web_chat, 8081/8082 firefly). The portrait bot doesn't
# use this port at all -- it reaches library_api over the shared
# auldwyn-net Docker network by container name instead.
LIBRARY_API_PORT=8083

# Prepended to the convenience URLs returned in GET /api/stories and
# /feed.xml (cover_url, epub_url, kepub_url, azw3_url, feed enclosure
# links). Set to match wherever this is actually publicly reachable --
# see README "Public access (Tailscale Funnel)". Leave blank if serving
# from the bare root instead of a sub-path.
PUBLIC_URL_PREFIX=/library

# Internal-only URL for the calibre_converter sidecar (see
# docker-compose.yml and calibre_converter/), reached over the shared
# auldwyn-net Docker network by container name -- not the host's
# published port, this never needs to be reachable from outside the
# network. Leave blank to disable AZW3/Kindle support entirely: azw3
# generation just no-ops and azw3_file/azw3_url stay null everywhere,
# same non-fatal-fallback contract kepubify already has if its binary's
# missing.
CALIBRE_CONVERTER_URL=http://calibre_converter:8000
