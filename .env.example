# Shared secret with the portrait bot's LIBRARY_API_INTERNAL_TOKEN (same
# value in both .env files). Gates the one write endpoint,
# POST /internal/ingest -- generate with e.g. `openssl rand -hex 24`.
# Leave blank to disable ingest entirely (the API still serves whatever
# was already ingested, read-only, matching Auldwyn-Lore's
# INTERNAL_API_TOKEN "blank disables the bypass" convention, just applied
# to an actual write path here instead of a rate-limit bypass).
INTERNAL_API_TOKEN=

# Host port library_api is published on. Chosen to avoid the other
# Auldwyn stacks already running on this box (8000 chroma, 8001
# query_api, 8080 web_chat, 8081/8082 firefly). The portrait bot doesn't
# use this port at all -- it reaches library_api over the shared
# auldwyn-net Docker network by container name instead.
LIBRARY_API_PORT=8083
